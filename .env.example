# MAGI+ Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# ── LLM API Key ───────────────────────────────
# Supported providers (auto-detected from key prefix):
#   Groq       → gsk_...          (free tier: console.groq.com)
#   OpenAI     → sk-... (51 chars) (platform.openai.com)
#   DeepSeek   → sk-... (35 chars) (platform.deepseek.com)
#   NVIDIA NIM → nvapi-...         (build.nvidia.com)

OPENAI_API_KEY=your_api_key_here

# ── Default Model ─────────────────────────────
# Groq (recommended, free): qwen/qwen3.8-27b | allam-2-7b | openai/gpt-oss-20b
# OpenAI:                   gpt-4o | gpt-4o-mini
# DeepSeek:                 deepseek-chat
DEFAULT_MODEL=qwen/qwen3.8-27b
